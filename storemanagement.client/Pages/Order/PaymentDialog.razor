@using StoreManagement.Shared.Helpers
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject NavigationManager Navigation

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(selectedMethod == "cash" ? "Thanh toán tiền mặt" : "Chọn phương thức thanh toán")</MudText>
    </TitleContent>
    <DialogContent>
        @if (selectedMethod == "")
        {
            <MudStack Spacing="3">
                <MudButton Variant="Variant.Outlined" 
                          Color="Color.Primary" 
                          Size="Size.Large"
                          FullWidth="true"
                          OnClick="@(() => SelectPaymentMethod("cash"))"
                          Disabled="isProcessing">
                    <MudStack Row="false" Spacing="1" AlignItems="AlignItems.Start" Class="py-2">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" />
                            <MudText Typo="Typo.h6">Tiền mặt</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Thanh toán trực tiếp tại cửa hàng</MudText>
                    </MudStack>
                </MudButton>

                <MudButton Variant="Variant.Outlined" 
                          Color="Color.Success" 
                          Size="Size.Large"
                          FullWidth="true"
                          OnClick="@(() => ProcessPayment("online"))"
                          Disabled="isProcessing">
                    <MudStack Row="false" Spacing="1" AlignItems="AlignItems.Start" Class="py-2">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" />
                            <MudText Typo="Typo.h6">MoMo</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">MoMo E-Wallet</MudText>
                    </MudStack>
                </MudButton>
            </MudStack>
        }
        else if (selectedMethod == "cash")
        {
            <MudStack Spacing="3">
                <MudNumericField @bind-Value="cashReceived" 
                                Label="Số tiền khách đưa" 
                                Variant="Variant.Outlined"
                                Min="0"
                                Format="N0"
                                Culture="@(new System.Globalization.CultureInfo("vi-VN"))"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.Payments"
                                Disabled="isProcessing"
                                Required="true"
                                RequiredError="Vui lòng nhập số tiền khách đưa"
                                HelperText="@cashError"
                                Error="@(!string.IsNullOrEmpty(cashError))" />

                <MudPaper Elevation="0" Class="pa-3 mud-theme-primary">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>Tiền thối lại:</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Error" Class="font-weight-bold">
                            @FormatHelper.ToVNPrice(cashReceived >= TotalAmount ? cashReceived - TotalAmount : 0)
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudStack>
        }

        <MudDivider Class="my-3" />
        
        <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText>Tổng tiền:</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@FormatHelper.ToVNPrice(TotalAmount)</MudText>
            </MudStack>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="Cancel" Disabled="isProcessing">
            @(selectedMethod == "cash" ? "Quay lại" : "Hủy")
        </MudButton>
        @if (selectedMethod == "cash")
        {
            <MudButton Color="Color.Primary" 
                      Variant="Variant.Filled" 
                      OnClick="ConfirmCashPayment"
                      Disabled="isProcessing">
                @(isProcessing ? "Đang xử lý..." : "Xác nhận thanh toán")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public decimal TotalAmount { get; set; }

    [Parameter]
    public int OrderId { get; set; }

    [Parameter]
    public string CustomerName { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnPaymentConfirmed { get; set; }

    private string selectedMethod = "";
    private decimal cashReceived = 0;
    private string cashError = "";
    private bool isProcessing = false;

    private void SelectPaymentMethod(string method)
    {
        selectedMethod = method;
        cashReceived = TotalAmount; // Default to exact amount
        cashError = "";
    }

    private async Task ProcessPayment(string method)
    {
        isProcessing = true;
        
        if (method == "online")
        {
            // Gọi API tạo payment MoMo
            try
            {
                var form = new MultipartFormDataContent
                {
                    { new StringContent(OrderId.ToString()), "OrderId" },
                    { new StringContent(TotalAmount.ToString("0")), "Amount" },
                    { new StringContent($"Thanh toán đơn hàng #{OrderId}"), "OrderInfo" },
                    { new StringContent(string.IsNullOrEmpty(CustomerName) ? "Khách hàng" : CustomerName), "FullName" }
                };
                
                var response = await Http.PostAsync("api/payment/CreatePaymentMomo", form);
                
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<MomoPaymentResponse>();
                    if (result != null && !string.IsNullOrEmpty(result.PayUrl))
                    {
                        // Mở trang MoMo trong tab/window mới hoặc redirect
                        Navigation.NavigateTo(result.PayUrl, true); // true = force load (thoát khỏi SPA)
                    }
                    else
                    {
                        Snackbar.Add("Không thể lấy link thanh toán MoMo", Severity.Error);
                    }
                }
                else
                {
                    Snackbar.Add("Lỗi khi tạo thanh toán MoMo", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            await OnPaymentConfirmed.InvokeAsync(method);
        }
        
        MudDialog.Close(DialogResult.Ok(method));
        isProcessing = false;
    }
    
    private class MomoPaymentResponse
    {
        public string PayUrl { get; set; } = "";
    }

    private async Task ConfirmCashPayment()
    {
        cashError = "";
        
        if (cashReceived < TotalAmount)
        {
            cashError = "Số tiền nhận phải lớn hơn hoặc bằng tổng cộng!";
            return;
        }

        await ProcessPayment("cash");
    }

    private void Cancel()
    {
        if (selectedMethod == "cash")
        {
            selectedMethod = "";
            cashError = "";
        }
        else
        {
            MudDialog.Cancel();
        }
    }
}

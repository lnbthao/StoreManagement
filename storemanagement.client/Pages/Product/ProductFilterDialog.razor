@using StoreManagement.Shared.DTOs

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudSelect @bind-Value="localFilters.Category" 
                      Label="Loại sản phẩm" 
                      Variant="Variant.Outlined"
                      AnchorOrigin="Origin.BottomCenter"
                      Class="mb-4">
                <MudSelectItem Value="@string.Empty">Tất cả loại</MudSelectItem>
                @foreach (var category in Categories)
                {
                    <MudSelectItem Value="@category">@category</MudSelectItem>
                }
            </MudSelect>

            <MudSelect @bind-Value="localFilters.Status" 
                      Label="Trạng thái" 
                      Variant="Variant.Outlined"
                      AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("all")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("active")">Đang bán</MudSelectItem>
                @if (HasInactive)
                {
                    <MudSelectItem Value="@("inactive")">Ngừng bán</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="HandleReset" Color="Color.Default">Reset</MudButton>
        <MudButton OnClick="HandleApply" Color="Color.Primary" Variant="Variant.Filled">Áp dụng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ProductFilterDto CurrentFilters { get; set; } = new();

    [Parameter]
    public List<string> Categories { get; set; } = new();

    [Parameter]
    public bool HasInactive { get; set; }

    private ProductFilterDto localFilters = new();

    protected override void OnInitialized()
    {
        localFilters = new ProductFilterDto
        {
            Category = CurrentFilters.Category,
            Status = CurrentFilters.Status
        };
    }

    private void HandleApply()
    {
        MudDialog.Close(DialogResult.Ok(localFilters));
    }

    private void HandleReset()
    {
        localFilters = new ProductFilterDto { Category = "", Status = "all" };
        MudDialog.Close(DialogResult.Ok(localFilters));
    }
}

@inherits LayoutComponentBase
@using StoreManagement.Client.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => drawerOpen = !drawerOpen)" />
        <MudText Typo="Typo.h6">Quản lý kho hàng</MudText>
        <MudSpacer />
        @if (currentUser != null)
        {
            <MudChip T="string" Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Variant="Variant.Text">
                @(string.IsNullOrEmpty(currentUser.FullName) ? currentUser.Username : currentUser.FullName) (@currentUser.Role)
            </MudChip>
        }
        else if (!isLoaded)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        }
        <MudIconButton Icon="@Icons.Material.Filled.Brightness4" Color="Color.Inherit" Title="Chế độ tối" />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="HandleLogout" Title="Đăng xuất" />
    </MudAppBar>
    
    <MudDrawer @bind-Open="drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/admin/product" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory">Sản phẩm</MudNavLink>
            <MudNavLink Href="/admin/category" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Loại sản phẩm</MudNavLink>
            <MudNavLink Href="/admin/supplier" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalShipping">Nhà cung cấp</MudNavLink>
            <MudNavLink Href="/admin/order" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">Đơn hàng</MudNavLink>
            <MudNavLink Href="/admin/customer" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Khách hàng</MudNavLink>
            <MudNavLink Href="/admin/promotion" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalOffer">Khuyến mãi</MudNavLink>
            <MudNavLink Href="/admin/user" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">Người dùng</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;
    private StoreManagement.Shared.DTOs.UserInfoDto? currentUser;
    private bool isLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user: {ex.Message}");
        }
        finally
        {
            isLoaded = true;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

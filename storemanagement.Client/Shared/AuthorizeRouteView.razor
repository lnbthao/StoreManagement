@using StoreManagement.Client.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

@if (isChecking)
{
    <MudContainer Class="mt-16 text-center">
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-4">Đang kiểm tra...</MudText>
    </MudContainer>
}
else if (isAuthenticated)
{
    <RouteView RouteData="@RouteData" DefaultLayout="@DefaultLayout" />
}

@code {
    [Parameter]
    public RouteData RouteData { get; set; } = null!;

    [Parameter]
    public Type? DefaultLayout { get; set; }

    private bool isChecking = true;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        isChecking = true;
        
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        
        // Cho phép truy cập trang login và trang chủ mà không cần authentication
        if (currentPath.StartsWith("login", StringComparison.OrdinalIgnoreCase) || 
            currentPath == "" || 
            currentPath == "/")
        {
            isAuthenticated = true;
            isChecking = false;
            return;
        }

        // Kiểm tra authentication cho các trang khác
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
        }
        
        isChecking = false;
    }
}

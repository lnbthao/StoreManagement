@page "/admin/customer"
@using StoreManagement.Shared.Models
@using StoreManagement.Shared.DTOs
@using StoreManagement.Shared.Helpers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Khách hàng | Quản lý kho hàng</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">QUẢN LÝ KHÁCH HÀNG</MudText>

    @* Action Bar *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Success" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/admin/customer/add"))"
                       FullWidth="true">
                Thêm khách hàng
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="OpenFilterDialog"
                       FullWidth="true">
                Lọc
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="12" md="7">
            <MudTextField @bind-Value="searchText"
                          Placeholder="Tìm tên khách hàng, SĐT, email..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          Clearable="true"
                          FullWidth="true" />
        </MudItem>
    </MudGrid>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        <MudText Align="Align.Center" Class="my-5">Đang tải danh sách khách hàng...</MudText>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-4">
            <strong>Lỗi:</strong> @errorMessage
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="2">
            <MudTable Items="@filteredCustomers" 
                      Hover="true" 
                      Striped="true" 
                      Dense="true"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Tên khách hàng</MudTh>
                    <MudTh>Số điện thoại</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Địa chỉ</MudTh>
                    <MudTh Style="text-align:center">Ngày tạo</MudTh>
                    <MudTh Style="text-align:center">Hành động</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.CustomerName</MudTd>
                    <MudTd>@(context.Phone ?? "—")</MudTd>
                    <MudTd>@(context.Email ?? "—")</MudTd>
                    <MudTd>@(context.Address ?? "—")</MudTd>
                    <MudTd Style="text-align:center">@(context.CreatedAt.HasValue ? FormatHelper.ToVNDate(context.CreatedAt.Value) : "—")</MudTd>
                    <MudTd Style="text-align:center">
                        <MudTooltip Text="Xem">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                         Color="Color.Info" 
                                         Size="Size.Small"
                                         OnClick="@(() => OpenViewDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Sửa">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                         Color="Color.Primary" 
                                         Size="Size.Small"
                                         OnClick="@(() => Navigation.NavigateTo($"/admin/customer/edit/{context.CustomerId}"))" />
                        </MudTooltip>

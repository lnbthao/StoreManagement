@page "/admin/customer/add"
@page "/admin/customer/edit/{id:int}"
@using StoreManagement.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(Id.HasValue ? "Sửa" : "Thêm") khách hàng | Quản lý kho hàng</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">
        @(Id.HasValue ? "SỬA KHÁCH HÀNG" : "THÊM KHÁCH HÀNG")
    </MudText>

    <MudPaper Elevation="2" Class="pa-6">
        @if (isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Align="Align.Center" Class="my-4">Đang tải...</MudText>
        }
        else
        {
            <MudForm @ref="form" @bind-IsValid="@isFormValid">
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="customer.CustomerName"
                                      Label="Tên khách hàng"
                                      Required="true"
                                      RequiredError="Vui lòng nhập tên khách hàng"
                                      Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="customer.Phone"
                                      Label="Số điện thoại"
                                      Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="customer.Email"
                                      Label="Email"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="customer.Address"
                                      Label="Địa chỉ"
                                      Lines="3"
                                      Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" Class="d-flex gap-2 justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   OnClick="@(() => Navigation.NavigateTo("/admin/customer"))">
                            Hủy
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="SaveCustomer"
                                   Disabled="@(!isFormValid || isSaving)">
                            @if (isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Đang lưu...</span>
                            }
                            else
                            {
                                <span>@(Id.HasValue ? "Cập nhật" : "Thêm mới")</span>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public int? Id { get; set; }

    private MudForm form;
    private bool isFormValid;
    private bool isLoading = false;
    private bool isSaving = false;
    private Customer customer = new() { CreatedAt = DateTime.Now, IsActive = true };

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await LoadCustomer();
        }
    }

    private async Task LoadCustomer()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetFromJsonAsync<Customer>($"api/customer/{Id}");
            if (response != null)
            {
                customer = response;
            }
            else
            {
                Snackbar.Add("Không tìm thấy khách hàng", Severity.Error);
                Navigation.NavigateTo("/admin/customer");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi tải dữ liệu: {ex.Message}", Severity.Error);
            Navigation.NavigateTo("/admin/customer");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveCustomer()
    {
        await form.Validate();
        if (!isFormValid) return;

        try
        {
            isSaving = true;
            HttpResponseMessage response;

            if (Id.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/customer/{Id}", customer);
            }
            else
            {
                customer.CreatedAt = DateTime.Now;
                response = await Http.PostAsJsonAsync("api/customer", customer);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    Id.HasValue ? "Cập nhật khách hàng thành công" : "Thêm khách hàng thành công",
                    Severity.Success
                );
                Navigation.NavigateTo("/admin/customer");
            }
            else
            {
                Snackbar.Add("Không thể lưu khách hàng", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi lưu: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}

@using StoreManagement.Shared.DTOs
@using StoreManagement.Shared.Models
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" />
            Bộ lọc khuyến mãi
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudSelect @bind-Value="filters.Status"
                           Label="Trạng thái"
                           Placeholder="Tất cả"
                           Clearable=true>
                    <MudSelectItem Value="@("active")">Hoạt động</MudSelectItem>
                    <MudSelectItem Value="@("inactive")">Ngừng</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSelect @bind-Value="filters.DiscountType"
                           Label="Loại giảm giá"
                           Placeholder="Tất cả"
                           Clearable=true>
                    <MudSelectItem Value="@("percent")">Phần trăm</MudSelectItem>
                    <MudSelectItem Value="@("fixed")">Số tiền cố định</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="filters.StartDate"
                               Label="Ngày bắt đầu"
                               Placeholder="dd/MM/yyyy"
                               Clearable=true />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="filters.EndDate"
                               Label="Ngày kết thúc"
                               Placeholder="dd/MM/yyyy"
                               Clearable=true />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Clear" Variant="Variant.Outlined">Xóa lọc</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Hủy</MudButton>
        <MudButton OnClick="Apply" Color="Color.Primary" Variant="Variant.Filled">Áp dụng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public PromotionFilterDto CurrentFilters { get; set; } = new();

    private PromotionFilterDto filters = new();

    protected override void OnInitialized()
    {
        filters = new PromotionFilterDto
        {
            Status = CurrentFilters.Status ?? "",
            DiscountType = CurrentFilters.DiscountType ?? "",
            StartDate = CurrentFilters.StartDate ?? null,
            EndDate = CurrentFilters.EndDate ?? null
        };
    }

    private void Apply()
    {
        if (filters.StartDate > filters.EndDate)
        {
            Snackbar.Add("Ngày bắt đầu phải nhỏ hơn ngày kết thúc!", Severity.Error, options =>
            {
                options.ShowTransitionDuration = 500;
                options.HideTransitionDuration = 400;
                options.VisibleStateDuration = 900;
            });
            return;
        }
        MudDialog.Close(DialogResult.Ok(filters));
    }


    private void Clear()
    {
        filters = new PromotionFilterDto();
    }

    private void Cancel() => MudDialog.Cancel();
}

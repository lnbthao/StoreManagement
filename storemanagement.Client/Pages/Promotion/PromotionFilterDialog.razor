@using StoreManagement.Shared.DTOs
@using StoreManagement.Shared.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" />
            Bộ lọc khuyến mãi
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudSelect T="string" 
                           @bind-Value="status" 
                           Label="Trạng thái"
                           Clearable="true"
                           Placeholder="Tất cả">
                    <MudSelectItem T="string" Value="@("active")">Hoạt động</MudSelectItem>
                    <MudSelectItem T="string" Value="@("inactive")">Ngưng</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="string" 
                           @bind-Value="discountType" 
                           Label="Loại giảm giá"
                           Clearable="true"
                           Placeholder="Tất cả">
                    <MudSelectItem T="string" Value="@("percent")">Phần trăm</MudSelectItem>
                    <MudSelectItem T="string" Value="@("fixed")">Số tiền cố định</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="startDate" 
                               Label="Từ ngày bắt đầu"
                               Clearable="true"
                               Placeholder="dd/MM/yyyy" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="endDate" 
                               Label="Đến ngày kết thúc"
                               Clearable="true"
                               Placeholder="dd/MM/yyyy" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Clear" Variant="Variant.Outlined">Xóa lọc</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Hủy</MudButton>
        <MudButton OnClick="Apply" Color="Color.Primary" Variant="Variant.Filled">Áp dụng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    private string? status;
    private string? discountType;
    private DateTime? startDate;
    private DateTime? endDate;

    private void Clear()
    {
        status = null;
        discountType = null;
        startDate = null;
        endDate = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Apply()
    {
        var filter = new PromotionFilterDto
        {
            Status = status,
            DiscountType = discountType,
            StartDate = startDate,
            EndDate = endDate
        };
        MudDialog.Close(DialogResult.Ok(filter));
    }
}

@page "/admin/product"
@attribute [Authorize(Roles = "admin")]
@using StoreManagement.Shared.Models
@using StoreManagement.Shared.DTOs
@using StoreManagement.Shared.Helpers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Sản phẩm | Quản lý kho hàng</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">QUẢN LÝ SẢN PHẨM</MudText>

    @* Action Bar *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="12" md="3">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Success" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/admin/product/add"))"
                       FullWidth="true">
                Thêm sản phẩm
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="9" md="7">
            <MudTextField @bind-Value="searchText"
                          Placeholder="Tìm tên hoặc barcode..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          Clearable="true"
                          FullWidth="true" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="OpenFilterDialog"
                       FullWidth="true">
                Lọc
            </MudButton>
        </MudItem>
    </MudGrid>

    @* Loading State *@
    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        <MudText Align="Align.Center" Class="my-5">Đang tải danh sách sản phẩm...</MudText>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-4">
            <strong>Lỗi:</strong> @errorMessage
        </MudAlert>
    }
    else
    {
        @* Product Table *@
        <MudPaper Elevation="2">
            <MudTable Items="@filteredProducts" 
                      Hover="true" 
                      Striped="true" 
                      Dense="true"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="text-align:center">Barcode</MudTh>
                    <MudTh>Tên sản phẩm</MudTh>
                    <MudTh Style="text-align:center">Loại</MudTh>
                    <MudTh Style="text-align:center">Tồn kho</MudTh>
                    <MudTh Style="text-align:right">Giá</MudTh>
                    <MudTh Style="text-align:center">Đơn vị</MudTh>
                    <MudTh Style="text-align:center">Hành động</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="text-align:center">@(context.Barcode ?? "—")</MudTd>
                    <MudTd>@(context.ProductName ?? "Không tên")</MudTd>
                    <MudTd Style="text-align:center">@(context.CategoryName ?? "—")</MudTd>
                    <MudTd Style="text-align:center">
                        @if (context.IsActive)
                        {
                            <span>@FormatHelper.ToVNNumber(context.StockQuantity ?? 0)</span>
                        }
                        else
                        {
                            <MudText Color="Color.Error">Ngừng bán</MudText>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@FormatHelper.ToVNPrice(context.Price)</MudTd>
                    <MudTd Style="text-align:center">@(context.Unit ?? "—")</MudTd>
                    <MudTd Style="text-align:center">
                        @if (context.IsActive)
                        {
                            <MudTooltip Text="Xem">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                             Color="Color.Info" 
                                             Size="Size.Small"
                                             OnClick="@(() => OpenViewDialog(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Sửa">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                             Color="Color.Primary" 
                                             Size="Size.Small"
                                             OnClick="@(() => Navigation.NavigateTo($"/admin/product/edit/{context.ProductId}"))" />
                            </MudTooltip>
                            <MudTooltip Text="Nhập kho">
                                <MudIconButton Icon="@Icons.Material.Filled.Inventory" 
                                             Color="Color.Success" 
                                             Size="Size.Small"
                                             OnClick="@(() => OpenInventoryDialog(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Xóa">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                             Color="Color.Error" 
                                             Size="Size.Small"
                                             OnClick="@(() => HandleToggleActive(context))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Khôi phục">
                                <MudIconButton Icon="@Icons.Material.Filled.Restore" 
                                             Color="Color.Success" 
                                             Size="Size.Small"
                                             OnClick="@(() => HandleToggleActive(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="py-5">Không có sản phẩm nào!</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<Product> productList = new();
    private List<Product> originalList = new();
    private List<string> categories = new();
    private bool hasInactive = false;
    
    private string searchText = string.Empty;
    private bool isLoading = true;
    private string? errorMessage = null;
    
    private ProductFilterDto filters = new() { Category = "", Status = "all" };
    
    private List<Product> filteredProducts
    {
        get
        {
            var result = originalList.ToList();
            
            // Search filter
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var keyword = searchText.ToLower();
                result = result.Where(p =>
                    (p.ProductName?.ToLower().Contains(keyword) ?? false) ||
                    (p.Barcode?.Contains(keyword) ?? false)
                ).ToList();
            }
            
            // Category filter
            if (!string.IsNullOrEmpty(filters.Category))
            {
                result = result.Where(p => p.CategoryName == filters.Category).ToList();
            }
            
            // Status filter
            if (filters.Status == "active")
            {
                result = result.Where(p => p.IsActive).ToList();
            }
            else if (filters.Status == "inactive")
            {
                result = result.Where(p => !p.IsActive).ToList();
            }
            
            return result;
        }
    }
    
    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }
    
    private async Task LoadProducts()
    {
        isLoading = true;
        errorMessage = null;
        
        try
        {
            var response = await Http.GetAsync("/api/product");
            
            if (response.IsSuccessStatusCode)
            {
                var data = await response.Content.ReadFromJsonAsync<List<Product>>() ?? new();
                originalList = data;
                productList = data;
                
                // Extract unique categories
                categories = data
                    .Where(p => !string.IsNullOrEmpty(p.CategoryName))
                    .Select(p => p.CategoryName!)
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();
                
                // Check if there are inactive products
                hasInactive = data.Any(p => !p.IsActive);
            }
            else
            {
                errorMessage = "Không tải được dữ liệu";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private async Task HandleToggleActive(Product product)
    {
        var action = product.IsActive ? "xóa" : "khôi phục";
        var confirmed = await DialogService.ShowMessageBox(
            "Xác nhận",
            $"Bạn có chắc muốn {action} sản phẩm \"{product.ProductName}\" không?",
            yesText: "Đồng ý", 
            cancelText: "Hủy"
        );
        
        if (confirmed != true) return;
        
        try
        {
            var endpoint = product.IsActive
                ? $"/api/product/{product.ProductId}/delete"
                : $"/api/product/{product.ProductId}/restore";
            
            var response = await Http.PutAsync(endpoint, null);
            
            if (response.IsSuccessStatusCode)
            {
                // Update UI
                var item = originalList.FirstOrDefault(p => p.ProductId == product.ProductId);
                if (item != null)
                {
                    item.IsActive = !item.IsActive;
                }
                
                Snackbar.Add($"Đã {action} thành công!", Severity.Success);
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Không thể thực hiện", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }
    
    private async Task OpenViewDialog(Product product)
    {
        var parameters = new DialogParameters<ProductViewDialog>
        {
            { x => x.Product, product }
        };
        
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<ProductViewDialog>("Chi tiết sản phẩm", parameters, options);
    }
    
    private async Task OpenFilterDialog()
{
    var parameters = new DialogParameters<ProductFilterDialog>
    {
        { x => x.CurrentFilters, filters },
        { x => x.Categories, categories },
        { x => x.HasInactive, hasInactive }
    };

    var options = new DialogOptions
    {
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true,               
        CloseButton = true
    };

    var dialog = await DialogService.ShowAsync<ProductFilterDialog>(
        "Lọc sản phẩm",
        parameters,
        options
    );

    var result = await dialog.Result;

    if (!result.Canceled && result.Data is ProductFilterDto newFilters)
    {
        filters = newFilters;
    }
}

    
    private async Task OpenInventoryDialog(Product product)
    {
        var parameters = new DialogParameters<InventoryDialog>
        {
            { x => x.Product, product }
        };
        
        var dialog = await DialogService.ShowAsync<InventoryDialog>($"Nhập kho - {product.ProductName}", parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is int newStock)
        {
            // Update stock in UI
            var item = originalList.FirstOrDefault(p => p.ProductId == product.ProductId);
            if (item != null)
            {
                item.StockQuantity = newStock;
            }
            
            Snackbar.Add($"Nhập kho thành công! Tồn kho mới: {newStock}", Severity.Success);
            StateHasChanged();
        }
    }
}

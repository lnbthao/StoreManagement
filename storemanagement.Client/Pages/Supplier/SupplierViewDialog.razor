@using StoreManagement.Shared.Models
@using StoreManagement.Shared.Helpers

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Nhà cung cấp #@Supplier?.SupplierId</MudText>
    </TitleContent>
    <DialogContent>
        @if (Supplier != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudText><strong>Tên nhà cung cấp:</strong> @(Supplier.SupplierName ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText><strong>Điện thoại:</strong> @(Supplier.Phone ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText><strong>Email:</strong> @(Supplier.Email ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText><strong>Địa chỉ:</strong> @(Supplier.Address ?? "—")</MudText>
                </MudItem>

            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Supplier? Supplier { get; set; }

    private void Cancel() => MudDialog.Cancel();
}

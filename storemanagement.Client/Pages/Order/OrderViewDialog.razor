@using StoreManagement.Shared.ViewModels
@using StoreManagement.Shared.Helpers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Đơn hàng #@Order?.OrderId</MudText>
    </TitleContent>
    <DialogContent>
        @if (Order != null)
        {
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption">Khách hàng</MudText>
                    <MudText Class="font-weight-bold">@(Order.CustomerName ?? Order.CustomerId?.ToString() ?? "Khách vãng lai")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption">Nhân viên</MudText>
                    <MudText Class="font-weight-bold">@(Order.UserName ?? Order.UserId?.ToString() ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption">Mã khuyến mãi</MudText>
                    <MudText Class="font-weight-bold">@(Order.PromoCode ?? Order.PromoId?.ToString() ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption">Ngày tạo</MudText>
                    <MudText Class="font-weight-bold">@FormatHelper.ToVNDate(Order.OrderDate)</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption">Trạng thái</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(Order.Status)">
                        @GetStatusText(Order.Status)
                    </MudChip>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption">Giảm giá</MudText>
                    <MudText Class="font-weight-bold">@FormatHelper.ToVNPrice(Order.DiscountAmount ?? 0)</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption">Tổng tiền</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@FormatHelper.ToVNPrice(Order.TotalAmount ?? 0)</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.h6" Class="mb-2">Sản phẩm trong đơn</MudText>
                    <MudTable Items="@Order.OrderItems" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh Style="text-align:center">Mã SP</MudTh>
                            <MudTh>Tên sản phẩm</MudTh>
                            <MudTh Style="text-align:center">Số lượng</MudTh>
                            <MudTh Style="text-align:right">Đơn giá</MudTh>
                            <MudTh Style="text-align:right">Thành tiền</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="text-align:center">@context.ProductId</MudTd>
                            <MudTd>@(context.ProductName ?? "—")</MudTd>
                            <MudTd Style="text-align:center">@context.Quantity</MudTd>
                            <MudTd Style="text-align:right">@FormatHelper.ToVNPrice(context.UnitPrice)</MudTd>
                            <MudTd Style="text-align:right"><strong>@FormatHelper.ToVNPrice(context.TotalPrice)</strong></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Align="Align.Center" Class="py-3">Không có sản phẩm trong đơn hàng</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Đóng</MudButton>
        @if (Order != null && (Order.Status == "paid" || Order.Status == "pending"))
        {
            <MudButton Color="Color.Error" OnClick="CancelOrder" Disabled="isCancelling">
                @(isCancelling ? "Đang hủy..." : "Hủy đơn hàng")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public OrderDetailViewModel? Order { get; set; }

    private bool isCancelling = false;

    private Color GetStatusColor(string? status)
    {
        return status?.ToLower() switch
        {
            "pending" => Color.Warning,
            "paid" => Color.Success,
            "canceled" => Color.Error,
            _ => Color.Default
        };
    }

    private string GetStatusText(string? status)
    {
        return status?.ToLower() switch
        {
            "pending" => "Chờ thanh toán",
            "paid" => "Đã thanh toán",
            "canceled" => "Đã hủy",
            _ => status ?? "—"
        };
    }

    private async Task CancelOrder()
    {
        if (Order == null) return;

        bool? confirm = await DialogService.ShowMessageBox(
            "Xác nhận hủy đơn hàng",
            $"Bạn có chắc chắn muốn hủy đơn hàng #{Order.OrderId}?\n\nSố lượng hàng và lượt sử dụng mã giảm giá sẽ được hoàn lại.",
            yesText: "Hủy đơn", cancelText: "Không");

        if (confirm != true) return;

        isCancelling = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"/api/order/{Order.OrderId}/status", new { status = "canceled" });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Đã hủy đơn hàng thành công!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add($"Lỗi: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi hủy đơn hàng: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCancelling = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

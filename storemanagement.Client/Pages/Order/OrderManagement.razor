@page "/admin/order"
@attribute [Authorize(Roles = "admin")]
@using StoreManagement.Shared.Models
@using StoreManagement.Shared.Helpers
@using StoreManagement.Shared.Enums
@using StoreManagement.Shared.DTOs
@using StoreManagement.Shared.ViewModels
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Đơn hàng | Quản lý kho hàng</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">QUẢN LÝ ĐƠN HÀNG</MudText>

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="OpenFilterDialog"
                       FullWidth="true">
                Lọc
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="6" md="9">
            <MudTextField @bind-Value="searchText" Placeholder="Tìm mã đơn, khách hàng..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="300" Clearable="true" FullWidth="true" />
        </MudItem>
    </MudGrid>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        <MudText Align="Align.Center" Class="my-5">Đang tải danh sách đơn hàng...</MudText>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-4"><strong>Lỗi:</strong> @errorMessage</MudAlert>
    }
    else
    {
        <MudPaper Elevation="2">
            <MudTable Items="@filteredOrders" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Mã ĐH</MudTh>
                    <MudTh>Khách hàng</MudTh>
                    <MudTh Style="text-align:center">Ngày tạo</MudTh>
                    <MudTh Style="text-align:right">Tổng tiền</MudTh>
                    <MudTh Style="text-align:center">Trạng thái</MudTh>
                    <MudTh Style="text-align:center">Hành động</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>#@context.OrderId</MudTd>
                    <MudTd>@(context.CustomerName ?? "Khách lẻ")</MudTd>
                    <MudTd Style="text-align:center">@FormatHelper.ToVNDate(context.OrderDate)</MudTd>
                    <MudTd Style="text-align:right">@FormatHelper.ToVNPrice(context.TotalAmount)</MudTd>
                    <MudTd Style="text-align:center">
                        @{
                            var statusEnum = OrderStatusExtensions.FromString(context.Status ?? "pending");
                            var statusText = statusEnum.ToDisplayString();
                            var statusColor = statusEnum switch
                            {
                                OrderStatus.Pending => Color.Warning,
                                OrderStatus.Paid => Color.Success,
                                OrderStatus.Canceled => Color.Error,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="@statusColor" Size="Size.Small">@statusText</MudChip>
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudTooltip Text="Xem chi tiết">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small"
                                         OnClick="@(() => ViewOrder(context))" />
                        </MudTooltip>
                        @if (context.Status == "pending")
                        {
                            <MudTooltip Text="Thanh toán">
                                <MudIconButton Icon="@Icons.Material.Filled.Payment" Color="Color.Success" Size="Size.Small"
                                             OnClick="@(() => ProcessPayment(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
        <MudText Typo="Typo.body2" Class="mt-2">Tổng: <strong>@filteredOrders.Count()</strong> đơn hàng</MudText>
    }
</MudContainer>

@code {
    private List<OrderDisplayDto> orders = new();
    private string searchText = "";
    private bool isLoading = true;
    private string errorMessage = "";
    private OrderFilterDto currentFilters = new();

    private IEnumerable<OrderDisplayDto> filteredOrders
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText)) return orders;
            var search = searchText.ToLower().Trim();
            return orders.Where(o =>
                o.OrderId.ToString().Contains(search) ||
                (o.CustomerName?.ToLower().Contains(search) ?? false)
            );
        }
    }

    protected override async Task OnInitializedAsync() => await LoadOrders();

    private async Task LoadOrders()
    {
        try
        {
            isLoading = true;
            errorMessage = "";
            
            // Build query string with filters
            var queryParams = new List<string>();
            
            if (currentFilters.StartDate.HasValue)
                queryParams.Add($"startDate={currentFilters.StartDate.Value:yyyy-MM-dd}");
            
            if (currentFilters.EndDate.HasValue)
                queryParams.Add($"endDate={currentFilters.EndDate.Value:yyyy-MM-dd}");
            
            if (currentFilters.UserId.HasValue)
                queryParams.Add($"userId={currentFilters.UserId.Value}");
            
            if (currentFilters.PromoId.HasValue)
                queryParams.Add($"promoId={currentFilters.PromoId.Value}");
            
            if (!string.IsNullOrEmpty(currentFilters.Status))
                queryParams.Add($"status={currentFilters.Status}");
            
            if (currentFilters.CategoryId.HasValue)
                queryParams.Add($"categoryId={currentFilters.CategoryId.Value}");
            
            var queryString = queryParams.Count > 0 ? "?" + string.Join("&", queryParams) : "";
            var url = $"api/order{queryString}";
            
            var response = await Http.GetFromJsonAsync<List<OrderDto>>(url);
            if (response != null)
            {
                // Map OrderDto sang OrderDisplayDto
                orders = response.Select(o => new OrderDisplayDto
                {
                    OrderId = o.OrderId,
                    OrderDate = o.OrderDate,
                    Status = o.Status,
                    TotalAmount = o.TotalAmount,
                    CustomerName = o.Customer?.Name ?? "Khách lẻ"
                }).ToList();
            }
            else
            {
                orders = new List<OrderDisplayDto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tải danh sách đơn hàng: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally { isLoading = false; }
    }

    private async Task ViewOrder(OrderDisplayDto order)
    {
        // Tải chi tiết đơn hàng từ API
        var fullOrder = await Http.GetFromJsonAsync<OrderDetailViewModel>($"api/order/{order.OrderId}");
        if (fullOrder != null)
        {
            var parameters = new DialogParameters<OrderViewDialog>
            {
                { x => x.Order, fullOrder }
            };

            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            var dialog = await DialogService.ShowAsync<OrderViewDialog>("Chi tiết đơn hàng", parameters, options);
            var result = await dialog.Result;

            // Reload if order was canceled in dialog
            if (!result.Canceled && result.Data is bool canceled && canceled)
            {
                await LoadOrders();
            }
        }
    }

    private async Task OpenFilterDialog()
    {
        var parameters = new DialogParameters<OrderFilterDialog>
        {
            { x => x.CurrentFilters, currentFilters },
            { x => x.Users, await LoadUsers() },
            { x => x.Promotions, await LoadPromotions() },
            { x => x.Categories, await LoadCategories() }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<OrderFilterDialog>("Lọc đơn hàng", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is OrderFilterDto filter)
        {
            currentFilters = filter;
            await ApplyFilters();
        }
    }

    private async Task ProcessPayment(OrderDisplayDto order)
    {
        var parameters = new DialogParameters<PaymentDialog>
        {
            { x => x.TotalAmount, order.TotalAmount },
            { x => x.OrderId, order.OrderId },
            { x => x.CustomerName, order.CustomerName },
            { x => x.OnPaymentConfirmed, EventCallback.Factory.Create<string>(this, async (method) =>
            {
                await CompletePayment(order.OrderId, method);
            })}
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<PaymentDialog>("Thanh toán đơn hàng", parameters, options);
    }

    private async Task CompletePayment(int orderId, string paymentMethod)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/order/{orderId}/status", new { Status = "paid" });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Thanh toán thành công!", Severity.Success);
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Không thể cập nhật trạng thái đơn hàng", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }
    
    // DTO để hiển thị trong bảng
    private class OrderDisplayDto
    {
        public int OrderId { get; set; }
        public DateTime OrderDate { get; set; }
        public string Status { get; set; } = "";
        public decimal TotalAmount { get; set; }
        public string CustomerName { get; set; } = "";
    }
    
    // DTO từ API
    private class OrderDto
    {
        public int OrderId { get; set; }
        public DateTime OrderDate { get; set; }
        public string Status { get; set; } = "";
        public decimal TotalAmount { get; set; }
        public IdNameDto? Customer { get; set; }
    }
    
    private class IdNameDto
    {
        public int Id { get; set; }
        public string? Name { get; set; }
    }
    
    private async Task<List<User>> LoadUsers()
    {
        try
        {
            return await Http.GetFromJsonAsync<List<User>>("api/user") ?? new();
        }
        catch { return new(); }
    }
    
    private async Task<List<Promotion>> LoadPromotions()
    {
        try
        {
            return await Http.GetFromJsonAsync<List<Promotion>>("api/promotion") ?? new();
        }
        catch { return new(); }
    }
    
    private async Task<List<Category>> LoadCategories()
    {
        try
        {
            return await Http.GetFromJsonAsync<List<Category>>("api/category") ?? new();
        }
        catch { return new(); }
    }
    
    private async Task ApplyFilters()
    {
        await LoadOrders();
    }
}
